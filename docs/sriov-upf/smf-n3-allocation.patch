+)
+
+func n3TestSession(upf *UPF, id uint16) (*SMContext, *DataPathNode) {
+	pdr := &PDR{PDRID: id, PDI: PDI{
+		SourceInterface: pfcpType.SourceInterface{InterfaceValue: pfcpType.SourceInterfaceAccess},
+		LocalFTeid:      &pfcpType.FTEID{Ch: true, V4: true},
+	}}
+	node := &DataPathNode{UPF: upf, UpLinkTunnel: &GTPTunnel{TEID: 77, PDR: pdr}}
+	c := &SMContext{
+		SmfPduSessionSmContextCreateData: &models.SmfPduSessionSmContextCreateData{},
+		LocalULTeid:                      77, SelectedPDUSessionType: 1,
+		Tunnel: &UPTunnel{DataPathPool: DataPathPool{
+			1: &DataPath{Activated: true, IsDefaultPath: true, FirstDPNode: node},
+		}},
+		PFCPContext: map[string]*PFCPSessionContext{
+			upf.NodeID.ResolveNodeIdToIp().String(): {PDRs: map[uint16]*PDR{id: pdr}},
+		},
+		SelectedSessionRuleID: "default",
+		SessionRules: map[string]*SessionRule{"default": {
+			DefQosQFI: 1,
+			SessionRule: &models.SessionRule{
+				AuthSessAmbr: &models.Ambr{Uplink: "1 Mbps", Downlink: "1 Mbps"},
+				AuthDefQos:   &models.AuthorizedDefaultQos{Var5qi: 9, Arp: &models.Arp{PriorityLevel: 8}},
+			},
+		}},
+	}
+	return c, node
+}
+
+func n3TestUPF() *UPF {
+	return &UPF{FTUP: true,
+		NodeID:       pfcpType.NodeID{NodeIdType: pfcpType.NodeIdTypeIpv4Address, IP: net.ParseIP("127.0.0.8").To4()},
+		N3Interfaces: []*UPFInterfaceInfo{{IPv4EndPointAddresses: []net.IP{net.ParseIP("198.51.100.1").To4()}}},
+	}
+}
+
+func n3TestCreated(id uint16, teid uint32, ip string) *pfcp.CreatedPDR {
+	return &pfcp.CreatedPDR{
+		PDRID:      &pfcpType.PacketDetectionRuleID{RuleId: id},
+		LocalFTEID: &pfcpType.FTEID{V4: true, Teid: teid, Ipv4Address: net.ParseIP(ip).To4()},
+	}
+}
+
+func TestAllocatedN3EndpointsInSetup(t *testing.T) {
+	upf := n3TestUPF()
+	for i, ip := range []string{"192.0.2.11", "192.0.2.12"} {
+		id, teid := uint16(i+1), uint32(0x1001+i)
+		c, node := n3TestSession(upf, id)
+		if _, err := BuildPDUSessionResourceSetupRequestTransfer(c); err == nil {
+			t.Fatal("N2 setup accepted an unresolved allocation")
+		}
+		created := n3TestCreated(id, teid, ip)
+		if err := c.ApplyCreatedN3PDR(upf, created); err != nil {
+			t.Fatal(err)
+		}
+		// Decoded PFCP storage can be reused after processing the response.
+		created.LocalFTEID.Ipv4Address[0] = 1
+		buf, err := BuildPDUSessionResourceSetupRequestTransfer(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var setup ngapType.PDUSessionResourceSetupRequestTransfer
+		if err := aper.UnmarshalWithParams(buf, &setup, "valueExt"); err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		for _, ie := range setup.ProtocolIEs.List {
+			switch ie.Id.Value {
+			case ngapType.ProtocolIEIDULNGUUPTNLInformation:
+				gtp := ie.Value.ULNGUUPTNLInformation.GTPTunnel
+				if !net.IP(gtp.TransportLayerAddress.Value.Bytes).Equal(net.ParseIP(ip)) ||
+					binary.BigEndian.Uint32(gtp.GTPTEID.Value) != teid {
+					t.Fatal("wrong allocated N3 endpoint in N2")
+				}
+				found = true
+			case ngapType.ProtocolIEIDAdditionalULNGUUPTNLInformation:
+				t.Fatal("allocation experiment advertised an additional tunnel")
+			}
+		}
+		if !found || c.LocalULTeid != 77 || node.UpLinkTunnel.TEID != teid {
+			t.Fatal("missing N2 tunnel or incorrect allocator/tunnel state")
+		}
+	}
+	if !upf.N3Interfaces[0].IPv4EndPointAddresses[0].Equal(net.ParseIP("198.51.100.1")) {
+		t.Fatal("session allocation changed shared UPF configuration")
+	}
+}
+
+func TestCreatedN3PDRRejectsInvalidAllocation(t *testing.T) {
+	cases := map[string]func(**pfcp.CreatedPDR){
+		"missing":        func(p **pfcp.CreatedPDR) { *p = nil },
+		"missing ID":     func(p **pfcp.CreatedPDR) { (*p).PDRID = nil },
+		"wrong ID":       func(p **pfcp.CreatedPDR) { (*p).PDRID.RuleId = 99 },
+		"missing FTEID":  func(p **pfcp.CreatedPDR) { (*p).LocalFTEID = nil },
+		"unresolved":     func(p **pfcp.CreatedPDR) { (*p).LocalFTEID.Ch = true },
+		"zero TEID":      func(p **pfcp.CreatedPDR) { (*p).LocalFTEID.Teid = 0 },
+		"missing IP":     func(p **pfcp.CreatedPDR) { (*p).LocalFTEID.Ipv4Address = nil },
+		"unspecified IP": func(p **pfcp.CreatedPDR) { (*p).LocalFTEID.Ipv4Address = net.IPv4zero },
+		"IPv6":           func(p **pfcp.CreatedPDR) { (*p).LocalFTEID.V6 = true },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			upf := n3TestUPF()
+			c, node := n3TestSession(upf, 1)
+			p := n3TestCreated(1, 0x1001, "192.0.2.11")
+			mutate(&p)
+			if c.ApplyCreatedN3PDR(upf, p) == nil {
+				t.Fatal("invalid allocation accepted")
+			}
+			if !node.UpLinkTunnel.PDR.PDI.LocalFTeid.Ch || node.UpLinkTunnel.TEID != 77 {
+				t.Fatal("rejected response modified session state")
+			}
+		})
+	}
+}
+
+func TestLegacyN3Endpoint(t *testing.T) {
+	upf := n3TestUPF()
+	upf.FTUP = false
+	c, node := n3TestSession(upf, 1)
+	ip, teid, err := node.N3Endpoint(c.SelectedPDUSessionType)
+	if err != nil || teid != 77 || !ip.Equal(net.ParseIP("198.51.100.1")) {
+		t.Fatal("legacy configured endpoint changed")
+	}
+}
