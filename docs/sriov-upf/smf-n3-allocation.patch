+package context
+
+import (
+	"fmt"
+	"net"
+
+	"github.com/nycu-ucr/pfcp"
+	"github.com/nycu-ucr/pfcp/pfcpType"
+)
+
+// ApplyCreatedN3PDR resolves the single N3 tunnel requested by this experiment.
+// The existing PDR and tunnel own the endpoint; UPF configuration stays shared.
+func (c *SMContext) ApplyCreatedN3PDR(upf *UPF, created *pfcp.CreatedPDR) error {
+	if created == nil || created.PDRID == nil || created.LocalFTEID == nil {
+		return fmt.Errorf("UPF allocation requires Created PDR with PDR ID and F-TEID")
+	}
+	pfcpCtx := c.PFCPContext[upf.NodeID.ResolveNodeIdToIp().String()]
+	if pfcpCtx == nil {
+		return fmt.Errorf("missing PFCP session for allocated N3 endpoint")
+	}
+	pdr := pfcpCtx.PDRs[created.PDRID.RuleId]
+	if pdr == nil || pdr.PDI.SourceInterface.InterfaceValue != pfcpType.SourceInterfaceAccess ||
+		pdr.PDI.LocalFTeid == nil || !pdr.PDI.LocalFTeid.Ch {
+		return fmt.Errorf("Created PDR %d does not match an N3 allocation request", created.PDRID.RuleId)
+	}
+	for _, other := range pfcpCtx.PDRs {
+		if other != pdr && other.PDI.LocalFTeid != nil && other.PDI.LocalFTeid.Ch {
+			return fmt.Errorf("experiment supports one N3 allocation per session")
+		}
+	}
+	fteid := *created.LocalFTEID
+	if fteid.Ch || fteid.Chid || !fteid.V4 || fteid.V6 || fteid.Teid == 0 ||
+		fteid.Ipv4Address.To4() == nil || fteid.Ipv4Address.IsUnspecified() {
+		return fmt.Errorf("Created PDR requires a resolved IPv4 F-TEID")
+	}
+	for _, path := range c.Tunnel.DataPathPool {
+		node := path.FirstDPNode
+		if path.Activated && node != nil && node.UPF == upf &&
+			node.UpLinkTunnel != nil && node.UpLinkTunnel.PDR == pdr {
+			fteid.Ipv4Address = append(net.IP(nil), fteid.Ipv4Address.To4()...)
+			pdr.PDI.LocalFTeid = &fteid
+			node.UpLinkTunnel.TEID = fteid.Teid
+			// LocalULTeid remains an SMF allocator ID, released by RemoveSMContext.
+			return nil
+		}
+	}
+	return fmt.Errorf("Created PDR does not belong to an active N3 tunnel")
+}
+
+// N3Endpoint supplies the per-session endpoint to the N2 setup message.
+func (node *DataPathNode) N3Endpoint(pduSessionType uint8) (net.IP, uint32, error) {
+	if node.UPF.FTUP {
+		pdr := node.UpLinkTunnel.PDR
+		if pdr == nil || pdr.PDI.LocalFTeid == nil {
+			return nil, 0, fmt.Errorf("missing allocated N3 endpoint")
+		}
+		f := pdr.PDI.LocalFTeid
+		if f.Ch || f.Chid || !f.V4 || f.V6 || f.Teid == 0 ||
+			f.Ipv4Address.To4() == nil || f.Ipv4Address.IsUnspecified() || node.UpLinkTunnel.TEID != f.Teid {
+			return nil, 0, fmt.Errorf("N3 allocation is unresolved or inconsistent")
+		}
+		return f.Ipv4Address.To4(), f.Teid, nil
+	}
+	if len(node.UPF.N3Interfaces) == 0 {
+		return nil, 0, fmt.Errorf("missing configured N3 interface")
+	}
+	ip, err := node.UPF.N3Interfaces[0].IP(pduSessionType)
+	return ip, node.UpLinkTunnel.TEID, err
+}
