#!/usr/bin/env python3
"""UPF-C/manager DN route helper. Install at the same absolute path on both nodes."""
import ipaddress
import json
import os
import re
import shlex
import subprocess
import sys

# An explicit protocol tag keeps rollback away from operator-managed routes.
PROTOCOL = "242"


def run(args):
    return subprocess.run(args, check=True, text=True, capture_output=True, timeout=5).stdout


def main():
    args = sys.argv[1:]
    if len(args) == 7 and args[0] == "--remote":
        host = args[1]
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@:-]*", host):
            raise ValueError("invalid SSH destination")
        command = ["timeout", "10s", "sudo", "-n", os.path.abspath(sys.argv[0]), *args[2:]]
        subprocess.run(["ssh", "-oBatchMode=yes", "-oConnectTimeout=5", host,
                        shlex.join(command)], check=True, timeout=14)
        return
    if len(args) != 5 or args[0] not in ("add", "del"):
        raise ValueError("usage: upf-dn-route [--remote user@host] add|del interface UE_IP N6_IP N6_MAC")
    operation, interface, ue, via, mac = args
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", interface):
        raise ValueError("invalid DN interface")
    for address in (ue, via):
        ip = ipaddress.IPv4Address(address)
        if ip.is_multicast or ip.is_unspecified or int(ip) == 0xffffffff:
            raise ValueError("unicast IPv4 required")
    if not re.fullmatch(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", mac):
        raise ValueError("invalid VF MAC")
    destination = ue + "/32"
    routes = json.loads(run(["ip", "-j", "-N", "route", "show", "exact", destination]))
    if routes and (len(routes) != 1 or routes[0].get("gateway") != via or
                   routes[0].get("dev") != interface or str(routes[0].get("protocol")) != PROTOCOL):
        raise ValueError("UE route already belongs to another next hop or owner")
    if operation == "add":
        run(["ip", "neigh", "replace", via, "lladdr", mac, "nud", "permanent", "dev", interface])
        if not routes:
            run(["ip", "route", "add", destination, "via", via, "dev", interface, "proto", PROTOCOL])
    elif routes:
        run(["ip", "route", "del", destination, "via", via, "dev", interface, "proto", PROTOCOL])


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print("upf-dn-route: " + str(error), file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr, file=sys.stderr)
        sys.exit(1)
